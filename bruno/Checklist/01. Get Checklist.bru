          "avatar_url": null,
          "claimed_item_count": 1
        },
        {
          "member_id": 4,
          "user_id": 13,
          "name": "Reza",
          "avatar_url": null,
          "claimed_item_count": 1
        }
      ],
      "items": [
        {
          "id": 13,
