          },
          "assigned_to": null,
          "can_claim": true,
          "can_release": false,
          "can_delete": true,
          "created_at": "2026-11-19T10:00:00Z",
          "updated_at": "2026-11-19T10:00:00Z"
        },
        {
          "id": 11,
          "title": "Blanket",
          "type": "GROUP",
