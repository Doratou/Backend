post {
  url: {{baseUrl}}/api/v1/attachments/batch/presigned-upload
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "items": [
