meta {
  name: 01. Generate Captcha
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/captcha/generate
  body: none
  auth: none
}

vars:post-response {
  captchaId: res.body.data.captcha_id
}

script:post-response {
  const resData = res.getBody();
  
  if (resData?.data?.captcha_image_base64) {
    const imgSrc = resData.data.captcha_image_base64;
    const captchaId = resData.data.captcha_id || '';
  
    const html = `
      <div style="font-family: sans-serif; padding: 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px;">
        <h3 style="margin: 0;">Captcha Preview</h3>
        <img src="${imgSrc}" alt="Captcha" style="border: 1px solid #ccc; border-radius: 6px; padding: 4px; background: #fff;" />
        <span style="font-size: 12px; color: #888;">ID: <code>${captchaId}</code></span>
      </div>
    `;
  
    bru.visualize('html', {
      name: 'Captcha',
      content: html
    });
  }
}
