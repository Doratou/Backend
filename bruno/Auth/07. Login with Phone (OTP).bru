meta {
  name: 07. Login with Phone (OTP)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login/phone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{testPhone}}"
  }
}

vars:post-response {
  token: res.body.data.access_token
  refreshToken: res.body.data.refresh_token
  userId: res.body.data.user.id
}
