meta {
  name: 01. Send OTP (Email)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Captcha-ID: {{captchaId}}
  X-Captcha-Code: 95384
}

body:json {
  {
    "identifier": "{{seedUserEmail}}X",
    "type": "email"
  }
}
