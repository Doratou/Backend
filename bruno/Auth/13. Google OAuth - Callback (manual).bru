meta {
  name: 13. Google OAuth - Callback (manual)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/auth/google/callback?code=AUTH_CODE_FROM_GOOGLE&state=STATE_FROM_REDIRECT
  body: none
  auth: none
}

params:query {
  code: AUTH_CODE_FROM_GOOGLE
  state: STATE_FROM_REDIRECT
}

vars:post-response {
  token: res.body.data.access_token
  refreshToken: res.body.data.refresh_token
  userId: res.body.data.user.id
}

docs {
  # Google OAuth - Callback
  
  **Method:** `GET`
  **Endpoint:** `/api/v1/auth/google/callback`
  **Auth:** None
  
  ## Description
  
  Callback endpoint that Google redirects to after the user authorizes the application.
  The server validates the `state` against Redis, exchanges the `code` for Google OIDC tokens, verifies the token claims, seamlessly registers or links the user account, and issues the application's JWT access and refresh token pair.
}
