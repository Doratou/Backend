meta {
  name: 10. Reset Password (OTP)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  ~X-Captcha-ID: {{captchaId}}
  ~X-Captcha-Code: 
}

body:json {
  {
    "identifier": "{{seedUserEmail}}",
    "type": "email",
    "new_password": "123123"
  }
}
