meta {
  name: 09. Change Password (Protected)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/password/change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "old_password": "{{seedUserPassword}}",
    "new_password": "NewUserPass@123"
  }
}
