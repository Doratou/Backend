meta {
  name: 02. Send OTP (Phone)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  ~X-Captcha-ID: {{captchaId}}
  ~X-Captcha-Code: 
}

body:json {
  {
    "identifier": "{{seedUserPhone}}",
    "type": "phone"
  }
}
