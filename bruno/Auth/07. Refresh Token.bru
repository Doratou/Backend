meta {
  name: 07. Refresh Token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

vars:post-response {
  token: res.body.data.access_token
  refreshToken: res.body.data.refresh_token
}
