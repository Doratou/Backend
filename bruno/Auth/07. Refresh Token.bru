meta {
  name: 07. Refresh Token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

vars:post-response {
  token: res.body.data.access_token
  refreshToken: res.body.data.refresh_token
}

docs {
  # Refresh Token

  **Method:** `POST`
  **Endpoint:** `/api/v1/auth/refresh`
  **Auth:** None

  ## Description

  Rotates the current refresh token and issues a brand-new access token and refresh token pair. The previously used refresh token is invalidated upon rotation.

  ## Request

  | Field | Type | Required | Description |
  | --- | --- | --- | --- |
  | `refresh_token` | `string` | Yes | Active refresh token issued during login/registration |

  ## Response

  **`200 OK`**
  ```json
  {
    "success": true,
    "data": {
      "access_token": "eyJhbGciOiJIUzI1NiIs...",
      "access_token_expires_at": "2026-10-26T21:45:00Z",
      "refresh_token": "eyJhbGciOiJIUzI1NiIs...",
      "refresh_token_expires_at": "2026-11-01T21:45:00Z"
    }
  }
  ```

  ## Errors

  * `400 Bad Request` — Missing refresh token parameter
  * `401 Unauthorized` — Invalid, revoked, or expired refresh token
  * `403 Forbidden` — User account is deactivated
}
