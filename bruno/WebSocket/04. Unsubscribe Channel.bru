meta {
  name: 04. Unsubscribe Channel
  type: ws
  seq: 4
}

ws {
  url: {{wsBaseUrl}}/api/v1/ws?token={{token}}
  body: ws
  auth: none
}

params:query {
  token: {{token}}
}

body:ws {
  name: ws.unsubscribe
  content: '''
    {
      "id": "unsub-1",
      "event": "ws.unsubscribe",
      "channel": "{{wsChannel}}"
    }
  '''
}

docs {
  # Unsubscribe from Channel

  **Protocol:** `WebSocket` (`ws://` / `wss://`)
  **Endpoint:** `/api/v1/ws?token=<access_token>`
  **Auth:** Query Parameter `token` (or `Authorization: Bearer`)

  ## Description
  Template frame for unsubscribing an active connection from a channel/room (`{{wsChannel}}`).

  ## Expected Server Response
  ```json
  {
    "id": "unsub-1",
    "event": "ws.unsubscribed",
    "channel": "room:test",
    "data": {
      "channel": "room:test"
    },
    "timestamp": "2026-11-26T10:30:15Z"
  }
  ```
}
