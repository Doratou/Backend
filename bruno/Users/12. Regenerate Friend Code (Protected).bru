meta {
  name: 12. Regenerate Friend Code (Protected)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/users/me/friend-code/regenerate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  **Method:** `POST`
  **Endpoint:** `/api/v1/users/me/friend-code/regenerate`
  **Auth:** Required

  ## Description

  Generates a new unique friend code for the authenticated user using the database function `generate_user_friend_code()`.

  ## Response

  **`200 OK`**
  ```json
  {
    "success": true,
    "data": {
      "id": 1,
      "name": "Default User",
      "friend_code": "DR-4X7P9Q2M8K6R",
      "email": "user@doratou.local",
      "phone": "+989123456789",
      "is_email_verified": true,
      "is_phone_verified": false,
      "avatar_attachment_id": null,
      "system_role": "USER",
      "status": "ACTIVE",
      "wallet": 0,
      "telegram_chat_id": null,
      "telegram_user_id": null,
      "created_at": "2026-11-11T10:00:00Z"
    }
  }
  ```

  ## Errors

  * `401 Unauthorized` — Missing or invalid token
  * `403 Forbidden` — Account deactivated
  * `404 Not Found` — User not found
}
