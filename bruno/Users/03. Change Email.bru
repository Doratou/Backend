meta {
  name: 03. Change Email
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/users/me/email
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "email": "new-email@doratou.local"
  }
}

docs {
  # Change Email

  **Method:** `PATCH`
  **Endpoint:** `/api/v1/users/me/email`
  **Auth:** Bearer access token

  Updates email after verifying OTP via `POST /api/v1/auth/otp/send` and `POST /api/v1/auth/otp/verify`.
}
