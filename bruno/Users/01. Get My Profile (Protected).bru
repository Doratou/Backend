meta {
  name: 01. Get My Profile (Protected)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  **Method:** `GET`
  **Endpoint:** `/api/v1/users/me`
  **Auth:** Required

  ## Description

  Retrieves the authenticated user's account details and friend code.

  ## Response

  **`200 OK`**
  ```json
  {
    "success": true,
    "data": {
      "id": 1,
      "name": "Default User",
      "friend_code": "DR-7K9M2X8Q4P6R",
      "email": "user@doratou.local",
      "phone": "+989123456789",
      "is_email_verified": true,
      "is_phone_verified": false,
      "avatar_attachment_id": null,
      "system_role": "USER",
      "status": "ACTIVE",
      "wallet": 0,
      "telegram_chat_id": null,
      "telegram_user_id": null,
      "created_at": "2026-11-11T10:00:00Z"
    }
  }
  ```

  ## Errors

  * `401 Unauthorized` — Missing or invalid token
  * `403 Forbidden` — Account deactivated
  * `404 Not Found` — User not found
}
