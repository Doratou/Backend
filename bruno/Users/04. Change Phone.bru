meta {
  name: 04. Change Phone
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/users/me/phone
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "phone": "+989120000000"
  }
}

docs {
  # Change Phone

  **Method:** `PATCH`
  **Endpoint:** `/api/v1/users/me/phone`
  **Auth:** Bearer access token

  Updates phone number after verifying OTP via `POST /api/v1/auth/otp/send` and `POST /api/v1/auth/otp/verify`.
}
