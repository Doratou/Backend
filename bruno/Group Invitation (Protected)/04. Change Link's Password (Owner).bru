meta {
  name: 04. Change Link's Password (Owner)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/invites/links/groups/{{groupId}}/{{inviteId}}/password
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "password": "new-password"
  }
}

