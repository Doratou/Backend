  accessToken: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjozLCJyb2xlIjoiVVNFUiIsInRva2VuX3R5cGUiOiJhY2Nlc3MiLCJzdWIiOiIzIiwiZXhwIjoxNzkzOTkzNzAzLCJpYXQiOjE3OTM5MDczMDMsImp0aSI6IjRjYmE4MDRiLTQyZjQtNGZhOS05OTMxLWU4YjBhMDFmN2ZhZiJ9.a27SvHzCkr6ds0yYjZ3KCvhMN4A780vgcDv2v7d4ta4
  inviteId: 2
  groupId: 1
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

docs {
  ## Method, Endpoint, and Auth
  `PATCH /api/v1/invites/links/groups/:groupID/:inviteID/password` — Group owner or site admin; Bearer access token required.
  ## Description
  Replaces the password required to use an invitation link.
  ## Request
  ### Path Parameters
  | Field | Type | Required | Description |
  | --- | --- | --- | --- |
  | `groupID` | `integer` | Yes | Positive group ID. |
  | `inviteID` | `integer` | Yes | Positive invitation ID. |
  ### Headers
  | Field | Type | Required | Description |
  | --- | --- | --- | --- |
  | `Authorization` | `string` | Yes | `Bearer <access-token>` |
  | `Content-Type` | `string` | Yes | `application/json` |
  ### Body
  | Field | Type | Required | Description |
  | --- | --- | --- | --- |
  | `password` | `string` | Yes | New invite password, 8–72 bytes. |
  ## Response
  **`200 OK`**
  ```json
  {"success": true, "data": {"message": "group invite password changed successfully"}}
  ```
  ## Errors
  - `400 BAD_REQUEST` — Either path ID is not a positive integer.
  - `400 INVITE_INVALID_PASSWORD_FORMAT` — Password is not 8–72 bytes or body is invalid.
  - `401 MISSING_TOKEN` — Access token is missing or invalid.
  - `403 GROUP_OWNER_REQUIRED` — Requester is neither the owner nor an admin.
  - `404 GROUP_NOT_FOUND` — Group does not exist or was deleted.
  - `404 INVITE_NOT_FOUND` — Invitation does not exist in this group.
  - `500 INTERNAL_SERVER_ERROR` — Invite password could not be changed.
}
