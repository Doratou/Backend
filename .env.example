# ===================================
# HTTP Server
# ===================================
HTTP_DOMAIN=0.0.0.0
HTTP_PORT=8080

# ===================================
# Postgres
# ===================================
PDB_HOST=127.0.0.1
PDB_PORT=15432
PDB_USER=doratou_user
PDB_PASSWORD=example-postgres-password-change-me
PDB_DB_NAME=doratou
PDB_SSL_MODE=disable

# ===================================
# Redis
# ===================================
RDB_HOST=127.0.0.1
RDB_PORT=16379
RDB_PASSWORD=example-redis-password-change-me
RDB_DB_NUMBER=0

# ===================================
# JWT Authentication
# ===================================
JWT_SECRET_KEY=change-this-example-jwt-secret-before-use
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=168h

# ===================================
# OTP Settings
# ===================================
OTP_TTL=3m
OTP_VERIFIED_TTL=15m
OTP_DIGITS=5

# ===================================
# Database Seeders
# ===================================
SEED_USER_NAME="Example User"
SEED_USER_EMAIL=user@example.com
SEED_USER_PHONE=+12025550101
SEED_USER_PASSWORD=example-user-password-change-me

SEED_ADMIN_NAME="Example Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=+12025550102
SEED_ADMIN_PASSWORD=example-admin-password-change-me

# ===================================
# Captcha Settings
# ===================================
CAPTCHA_ENABLED=true
CAPTCHA_TTL=2m

# ===================================
# Invitation Settings
# ===================================
INVITE_ENCRYPTION_SECRET=your-completely-different-secret-for-invites-here
GROUP_DIRECT_INVITE_REJECT_COOLDOWN=24h

# ===================================
# Email Settings
# ===================================
DORATOU_EMAIL=sender@example.com
DORATOU_EMAIL_APP_PASSWORD=replace-with-your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_HOST_PORT=587
EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_MODE=SMTP

# ===================================
# RustFS / S3 Storage Settings
# ===================================
RUSTFS_ENDPOINT=127.0.0.1:9000
RUSTFS_ACCESS_KEY_ID=adminadminadmin
RUSTFS_SECRET_ACCESS_KEY=adminadminadmin
RUSTFS_BUCKET_NAME=doratou-storage
RUSTFS_USE_SSL=false
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_URL_PREFIX=http://127.0.0.1:9000/doratou-storage
RUSTFS_MAX_CONCURRENCY=8
EMAIL_FONT_BASE_URL=

# ===================================
# Friendship Settings
# ===================================
FRIENDSHIP_REQUEST_COOLDOWN=24h

# ===================================
# PoW Two-Layer Rate Limiter
# ===================================
# Secret key used to HMAC-sign challenges (keep this secret, rotate to invalidate
# all in-flight challenges).
POW_HMAC_SECRET=change-this-pow-hmac-secret-before-use

# How long an issued challenge remains valid for submission.
POW_CHALLENGE_TTL=5m

# How long a client stays blocked in Redis after hitting the L2 limit,
# unless they solve the PoW challenge earlier.
POW_BLOCK_TTL=15m

# Number of leading zero bits required in a valid solution hash.
# 16 ≈ fast (< 1 s), 20 ≈ moderate (a few seconds), 24+ ≈ slow.
POW_DIFFICULTY=16

# Outer (permissive) rate limit: requests per second before a plain 429.
POW_L1_LIMIT=50

# Inner (strict) rate limit: requests per second before a 423 + PoW challenge.
# Must be lower than POW_L1_LIMIT.
POW_L2_LIMIT=20
